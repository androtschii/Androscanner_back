# Скопируй в .env и заполни. Файл .env в git не попадает.
#
# Сгенерировать секрет:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Ключ подписи JWT. Обязателен, дефолта нет намеренно.
JWT_SECRET=

# Пароль пользователя PostgreSQL
POSTGRES_PASSWORD=

# Учётка администратора, создаётся при первом запуске.
# Минимум 10 символов — короче схема не примет.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Откуда фронтенду разрешено обращаться к API (JSON-массив)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Уведомления и команды бота в Telegram. Пусто = выключены.
# Получить токен: @BotFather -> /newbot. Chat ID: написать боту
# сообщение и открыть https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Адрес API, вшиваемый в сборку фронтенда (сервис web). По умолчанию —
# localhost, подходит только для этой же машины. Для демо по локальной
# сети — LAN-адрес этой машины, например http://192.168.1.50:8000
# (и тогда api нужно открыть не только на 127.0.0.1 — см. docker-compose.yml)
VITE_API_URL=http://localhost:8000
