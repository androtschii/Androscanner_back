DATABASE_URL=postgresql+psycopg://scanner:scanner@db:5432/scanner
REDIS_URL=redis://redis:6379/0

# Обязательно: сгенерируй свой, например `python -c "import secrets;print(secrets.token_hex(32))"`
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# Список разрешённых для CORS источников — JSON-массив
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Путь к nmap. Пусто = искать в PATH (Linux/Docker).
# Windows: NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
NMAP_PATH=

# true  — сканы уходят в Celery (нужен запущенный Redis + воркер)
# false — выполняются прямо в процессе API через BackgroundTasks (dev на Windows)
USE_CELERY=false

# Уведомления в Telegram. Пусто = выключены — бот не обязателен для работы.
# Как получить: напиши @BotFather -> /newbot -> получишь TELEGRAM_BOT_TOKEN.
# Затем напиши своему новому боту любое сообщение и открой в браузере
# https://api.telegram.org/bot<TOKEN>/getUpdates — там будет chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
